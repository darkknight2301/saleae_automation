# TC12 (extended list) - Write Pattern -> Controller Reset -> Read -> Compare   (DESTRUCTIVE write; needs allow_destructive=yes)
# Smallest example of "data must survive an event": write known data, trigger the event, wait, read back, cmp.
TEST "TC12 Read/Write Across Controller Reset"

RUN "mkdir -p {{work_dir}}"
EXPECT_EXIT 0
RUN "nvme id-ns {{ns}} -o json | python3 tools/nvme_util.py id-ns --metric lba_bytes --bare" CAPTURE lba_bytes
EXPECT_EXIT 0
RUN "echo $(( ({{io_block_count0}} + 1) * {{lba_bytes}} ))" CAPTURE data_bytes
EXPECT_EXIT 0
RUN "python3 tools/nvme_util.py pattern {{work_dir}}/tc12_write.bin {{data_bytes}} 12"
EXPECT_EXIT 0
RUN "tools/guard.sh {{allow_destructive}} nvme write {{ns}} --start-block={{io_start_block}} --block-count={{io_block_count0}} --data-size={{data_bytes}} --data={{work_dir}}/tc12_write.bin"
EXPECT_EXIT 0
RUN "nvme reset {{ctrl}}"
EXPECT_EXIT 0
RUN "tools/wait_until.sh {{reset_wait_s}} 1 'nvme id-ns {{ns}}'"
EXPECT_EXIT 0
RUN "nvme read {{ns}} --start-block={{io_start_block}} --block-count={{io_block_count0}} --data-size={{data_bytes}} --data={{work_dir}}/tc12_read.bin"
EXPECT_EXIT 0
RUN "cmp {{work_dir}}/tc12_write.bin {{work_dir}}/tc12_read.bin"
EXPECT_EXIT 0

END
