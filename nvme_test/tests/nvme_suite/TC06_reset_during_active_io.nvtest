# TC06 - Controller Reset During Active I/O   (DESTRUCTIVE: fio writes + reset; needs allow_destructive=yes)
# Patterns:  PARALLEL block = fio running while a delayed reset fires;  wait_until.sh = event-based recovery wait;
#            "sentinel" = data written BEFORE the reset in an LBA range fio never touches -> proves completed writes survive.
# The fio run is EXPECTED to be disrupted by the reset, so its exit code is deliberately not asserted.
# (Add a `dmesg | grep -i nvme` RUN if your harness may read the kernel log.)
TEST "TC06 Controller Reset During Active I/O"

RUN "mkdir -p {{work_dir}}"
EXPECT_EXIT 0

# 1-2. baseline: device visible, namespace geometry, SMART snapshot
RUN "nvme list"
EXPECT_EXIT 0
RUN "nvme id-ns {{ns}} -o json | python3 tools/nvme_util.py id-ns --metric lba_bytes --bare" CAPTURE lba_bytes
EXPECT_EXIT 0
RUN "nvme id-ns {{ns}} -o json | python3 tools/nvme_util.py id-ns --metric nsze --bare" CAPTURE nsze0
EXPECT_EXIT 0
RUN "nvme smart-log {{ctrl}} -o json | python3 tools/nvme_util.py save {{work_dir}}/smart_tc06.json"
EXPECT_EXIT 0

# sentinel: a known pattern just above the region fio is allowed to use
RUN "echo $(( {{fio_region_bytes}} / {{lba_bytes}} + 8 ))" CAPTURE sentinel_lba
EXPECT_EXIT 0
RUN "echo $(( ({{io_block_count0}} + 1) * {{lba_bytes}} ))" CAPTURE data_bytes
EXPECT_EXIT 0
RUN "python3 tools/nvme_util.py pattern {{work_dir}}/sentinel.bin {{data_bytes}} 6"
EXPECT_EXIT 0
RUN "tools/guard.sh {{allow_destructive}} nvme write {{ns}} --start-block={{sentinel_lba}} --block-count={{io_block_count0}} --data-size={{data_bytes}} --data={{work_dir}}/sentinel.bin"
EXPECT_EXIT 0

# 3-4. continuous I/O in the region below the sentinel, with a controller reset in the middle
PARALLEL
RUN "tools/guard.sh {{allow_destructive}} fio --name=randrw --filename={{ns}} --rw=randrw --bs=4k --iodepth=16 --direct=1 --offset=0 --size={{fio_region_bytes}} --runtime={{fio_rand_runtime}} --time_based --output-format=json"
RUN "sleep {{reset_delay_s}}; nvme reset {{ctrl}}"
EXPECT_EXIT 0
END_PARALLEL

# 5-7. controller and namespace must come back; geometry unchanged
RUN "tools/wait_until.sh {{reset_wait_s}} 1 'nvme id-ctrl {{ctrl}}'"
EXPECT_EXIT 0
RUN "tools/wait_until.sh {{reset_wait_s}} 1 'nvme id-ns {{ns}}'"
EXPECT_EXIT 0
RUN "nvme id-ns {{ns}} -o json | python3 tools/nvme_util.py id-ns --metric nsze --bare" CAPTURE nsze1
EXPECT_EXIT 0
RUN "echo nsze_unchanged $(( {{nsze0}} == {{nsze1}} ))"
EXPECT "nsze_unchanged" EQ 1
RUN "nvme list"
EXPECT_EXIT 0

# 5/restart I/O: a fresh workload must run cleanly after the reset
RUN "tools/guard.sh {{allow_destructive}} fio --name=after_reset --filename={{ns}} --rw=randrw --bs=4k --iodepth=16 --direct=1 --offset=0 --size={{fio_region_bytes}} --runtime={{fio_short_runtime}} --time_based --output-format=json | python3 tools/fio_metrics.py"
EXPECT_EXIT 0
EXPECT "total_iops" GT 0
EXPECT "error" EQ 0

# 8. SMART healthy; completed writes (sentinel) intact
RUN "nvme smart-log {{ctrl}} -o json | python3 tools/nvme_util.py delta-from {{work_dir}}/smart_tc06.json"
EXPECT_EXIT 0
EXPECT "critical_warning" EQ 0
EXPECT "d_media_errors" EQ 0
RUN "nvme read {{ns}} --start-block={{sentinel_lba}} --block-count={{io_block_count0}} --data-size={{data_bytes}} --data={{work_dir}}/sentinel_after.bin"
EXPECT_EXIT 0
RUN "cmp {{work_dir}}/sentinel.bin {{work_dir}}/sentinel_after.bin"
EXPECT_EXIT 0

END
