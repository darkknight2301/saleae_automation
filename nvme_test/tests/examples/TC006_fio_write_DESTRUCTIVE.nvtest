# !!! DESTRUCTIVE - DO NOT RUN AGAINST A DEVICE YOU CARE ABOUT !!!
# This job writes directly to a raw block device and WILL destroy any data
# and filesystem currently on it. Provided as a reference example only.
#
# Prerequisites before running for real:
#   - fio installed
#   - A real NVMe namespace block device (e.g. /dev/nvme0n1)
#   - Explicit confirmation this exact device is safe to overwrite
#   - The device path below updated to match your target device
#
# The framework's own verification (`python3 run.py` with no arguments)
# never discovers or executes files in this examples/ directory
# automatically -- this file must be run explicitly and deliberately:
#     python3 run.py tests/examples/TC006_fio_write_DESTRUCTIVE.nvtest
TEST "FIO Sequential Write (DESTRUCTIVE - real block device)"

RUN "fio --name=seq_write --filename=/dev/nvme0n1 --rw=write --bs=128k --size=1G --numjobs=1 --direct=1"

EXPECT_EXIT 0

END
