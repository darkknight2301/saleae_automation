# Requires: nvme-cli installed. Does not require a real device to be
# meaningful -- nvme-cli rejects an unrecognized/invalid argument before
# it ever touches hardware, so this is safe to run even against a
# nonexistent device path.
#
# Negative test: a deliberately invalid field/argument is expected to
# make nvme-cli fail (nonzero exit) and print an error to stderr -- this
# is validated with EXPECT_STDERR, since plain EXPECT only ever looks at
# stdout and cannot see this error message at all.
TEST "Identify Controller - Invalid Field (real nvme-cli)"

RUN "nvme id-ctrl {{device}} --this-field-does-not-exist=1"

EXPECT_EXIT 1
EXPECT_STDERR "invalid" NOT_EMPTY

END
