TEST "Admin Passthru - Identify Controller (raw bytes)"

RUN "nvme admin-passthru /dev/nvme0 --opcode=0x06 --cdw10=1 --data-len=4096 --read --raw-binary"

EXPECT_EXIT 0
# Bytes 0-1 of the Identify Controller structure are the PCI Vendor ID
# (VID), little-endian. Replace these with your controller's actual VID.
EXPECT_BYTE 0x00 0x00
EXPECT_BYTE 0x01 0x00

END
