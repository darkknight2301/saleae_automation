# Safe: writes only to a regular file under /tmp, never a raw block
# device. Demonstrates the "run fio, run some command, run fio again,
# then validate the parsed output parameters numerically" pattern using
# REAL fio -- not a mock. Each fio RUN pipes its --output-format=json
# result through the common helper tools/fio_metrics.py, which prints
# clean "field value" lines that EXPECT ... GE/LE etc. can parse and
# compare. The helper exposes EVERY fio field (run it with --list to see
# the names); --metric picks just the ones this test needs.
# Requires: fio installed. Run from the nvme_test/ directory (tools/ path is relative).
TEST "FIO Write + Health Check + FIO Read, With Numeric Validation"

RUN "fio --name=w --filename=/tmp/nvme_test_numeric_fio.bin --size=4M --rw=write --bs=4k --numjobs=1 --output-format=json | python3 tools/fio_metrics.py --metric write_iops --metric write_bw"

EXPECT_EXIT 0
EXPECT "write_iops" GE 1
EXPECT "write_bw" GT 0

RUN "lsblk"

EXPECT_EXIT 0

RUN "fio --name=r --filename=/tmp/nvme_test_numeric_fio.bin --size=4M --rw=read --bs=4k --numjobs=1 --output-format=json | python3 tools/fio_metrics.py --metric read_iops --metric read_bw"

EXPECT_EXIT 0
EXPECT "read_iops" GE 1
EXPECT "read_bw" GT 0

END
