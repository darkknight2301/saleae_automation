# Safe: targets a regular file under /tmp, NOT a raw block device. Proves
# fio integration works through the framework without touching any
# disk/partition. Requires: fio installed.
TEST "FIO Smoke Test (file-based, safe)"

RUN "fio --name=safe_smoke --filename=/tmp/nvme_test_fio_smoke.bin --size=4M --rw=write --bs=4k --numjobs=1 --minimal"

EXPECT_EXIT 0

END
