# Requires: nvme-cli installed AND a real NVMe controller at {{device}}.
# CAUTION: `nvme reset` interrupts in-flight I/O on the controller -- do
# not run this against a device with active workloads from anything else.
# Not destructive to stored data under normal conditions, but disruptive
# enough that it is not auto-executed by the framework's own verification.
#
# Real-hardware version of the concurrent stress pattern: id-ctrl looped
# 1000x concurrently with reset looped 100x, in one .nvtest file, exactly
# matching "run id-ctrl in a loop 1000 times and nvme reset in a loop 100
# times in separate terminals at the same time".
TEST "Concurrent Identify + Reset Stress (real hardware)"

PARALLEL
RUN "nvme id-ctrl {{device}}" LOOP 1000
EXPECT_EXIT 0

RUN "nvme reset {{device}}" LOOP 100
EXPECT_EXIT 0
END_PARALLEL

END
