# Requires: nvme-cli installed AND a real NVMe controller at /dev/nvme0.
# admin-passthru issues a raw NVMe admin command. This example issues
# Identify Controller (opcode 0x06) manually and reads the 4096-byte data
# structure back on stdout, then validates specific raw bytes in it --
# demonstrating EXPECT_BYTE against real hardware output.
#
# Read-only (--read, no state-modifying cdw values), but still requires
# real hardware to produce meaningful output, so it is not auto-executed
# by the framework's own verification.
TEST "Admin Passthru - Identify Controller (raw bytes)"

RUN "nvme admin-passthru /dev/nvme0 --opcode=0x06 --cdw10=1 --data-len=4096 --read --raw-binary"

EXPECT_EXIT 0
# Bytes 0-1 of the Identify Controller structure are the PCI Vendor ID
# (VID), little-endian. Replace these with your controller's actual VID.
EXPECT_BYTE 0x00 0x00
EXPECT_BYTE 0x01 0x00

END
