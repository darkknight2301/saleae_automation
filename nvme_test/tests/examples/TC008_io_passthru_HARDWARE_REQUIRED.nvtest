# Requires: nvme-cli installed AND a real NVMe namespace at /dev/nvme0n1.
# io-passthru issues a raw NVMe I/O command -- here, a 4KB Read at LBA 0.
# Demonstrates EXPECT_HEX against real hardware output.
#
# Read-only (opcode 0x02 = Read), but still requires real hardware and a
# known-good LBA 0 signature to be meaningful, so it is not auto-executed
# by the framework's own verification.
TEST "IO Passthru - Read LBA 0 (raw bytes)"

RUN "nvme io-passthru /dev/nvme0n1 --opcode=0x02 --namespace-id=1 --cdw10=0 --cdw12=0 --data-len=4096 --read --raw-binary"

EXPECT_EXIT 0
# Validate the first 8 bytes read back from LBA 0 against a known-good hex
# signature. Replace with the actual expected content for your device.
EXPECT_HEX 0x00 "0000000000000000"

END
