# Requires: nvme-cli installed AND a real NVMe controller at /dev/nvme0.
# Adjust the device path to match your system (see `nvme list` output).
# Read-only command; safe on real hardware.
TEST "Identify Controller"

RUN "nvme id-ctrl /dev/nvme0"

EXPECT_EXIT 0
EXPECT "Firmware Revision" NOT_EMPTY

END
