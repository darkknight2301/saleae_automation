# Requires: nvme-cli installed AND a real NVMe controller (device path
# resolved from {{device}} in common_variables.json -- edit that file to
# match your system; see `nvme list`).
# Read-only command; safe on real hardware.
#
# Combined-automation Example 1: single-step identify.
TEST "Combined Example 1 - Identify"

RUN "nvme id-ctrl {{device}}"

EXPECT_EXIT 0
EXPECT "Firmware Revision" NOT_EMPTY
EXPECT "Model Number" CONTAINS "{{expected_model}}"

END
