# Requires: nvme-cli installed AND a real NVMe controller at {{device}}.
# Read-only commands; safe on real hardware.
#
# Combined-automation Example 2: identify -> smart-log. Each EXPECT binds
# to its nearest preceding RUN (command context rule -- see runner.py).
TEST "Combined Example 2 - Identify + SMART"

RUN "nvme id-ctrl {{device}}"

EXPECT_EXIT 0
EXPECT "Firmware Revision" NOT_EMPTY

RUN "nvme smart-log {{device}}"

EXPECT_EXIT 0
EXPECT "critical_warning" CONTAINS "0"

END
