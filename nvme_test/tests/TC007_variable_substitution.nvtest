# Demonstrates {{name}} substitution from common_variables.json.
# "device" resolves to /dev/nvme0; since no real hardware is present in
# verification, this uses a safe mock RUN (echo) instead of a real nvme
# command, but exercises substitution in both RUN and EXPECT the same way.
TEST "Variable Substitution"

RUN "echo Target device is {{device}}"

EXPECT_EXIT 0
EXPECT "Target device" CONTAINS "{{device}}"

END
